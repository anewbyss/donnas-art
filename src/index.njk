---
layout: layouts/base.njk
permalink: /
---
{%- set featured = collections.artworks | featured -%}
{%- set showcase = (featured if featured.length >= 3 else collections.artworks) | head(3) -%}
<section class="frontispiece">
  {% if site.hero_image %}
    <div class="arch">
      <img src="{{ site.hero_image }}" alt="" draggable="false" sizes="(min-width: 900px) 520px, 80vw" loading="eager" fetchpriority="high">
    </div>
  {% endif %}
  <p class="mono kicker">{{ site.tagline }}</p>
  <h1>{{ site.hero_heading }}</h1>
  <p class="incant">{{ site.hero_text }}</p>
  <p class="mono enter">
    <a href="/gallery/">Enter the works →</a>
    {% if site.commissions_open %}<a href="/contact/#request">Commission a piece →</a>{% endif %}
  </p>
</section>

{% if showcase.length %}
<section class="chapter">
  <header class="chapter-head">
    <h2>{{ "Upon the altar" if featured.length >= 3 else "Newest works" }}</h2>
    <a class="mono" href="/gallery/">All {{ collections.artworks.length }} plates →</a>
  </header>
  <div class="triptych">
    {% for art in showcase %}{% include "partials/card.njk" %}{% endfor %}
  </div>
</section>
{% endif %}

{% if collections.categories.length %}
<section class="chapter">
  <header class="chapter-head">
    <h2>The arcana</h2>
    <a class="mono" href="/collections/">By style, era & theme →</a>
  </header>
  {% set cats = collections.categories | head(8) %}
  {% include "partials/collection-tiles.njk" %}
</section>
{% endif %}

{% if site.commissions_open %}
<section class="chapter summons">
  <p class="mono kicker">Commissions are open</p>
  <p class="summons-line">{{ site.commissions_text }}</p>
  <a class="btn" href="/contact/#request">Send word</a>
</section>
{% endif %}
