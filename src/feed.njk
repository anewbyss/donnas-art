---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title }} — new work</title>
  <subtitle>{{ site.description }}</subtitle>
  <link href="{{ '/feed.xml' | absolute(env.siteUrl) }}" rel="self"/>
  <link href="{{ '/' | absolute(env.siteUrl) }}"/>
  <id>{{ '/' | absolute(env.siteUrl) }}</id>
  <updated>{{ (collections.artworks[0].date if collections.artworks.length else page.date) | isoDate }}</updated>
  <author><name>{{ site.title }}</name></author>
  {%- for art in collections.artworks | head(30) %}
  {%- set link = art.url | absolute(env.siteUrl) %}
  <entry>
    <title>{{ art.data.title }}</title>
    <link href="{{ link }}"/>
    <id>{{ link }}</id>
    <updated>{{ art.date | isoDate }}</updated>
    <content type="html">{{ ('<p><img src="' + (art.data.image | absolute(env.siteUrl)) + '" alt=""></p>' + art.content) | escape }}</content>
  </entry>
  {%- endfor %}
</feed>
