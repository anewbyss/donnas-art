{#- Numbered index of collections. Expects `cats`. -#}
<ol class="arcana">
  {% for c in cats %}
    {%- set works = collections.artworks | inCategory(c.data.title) -%}
    {%- set cover = c.data.image or (works[0].data.image if works.length) -%}
    <li>
      <a href="{{ c.url }}">
        <span class="mono arcana-no">{{ loop.index | roman }}</span>
        <span class="arcana-name">{{ c.data.title }}</span>
        <span class="mono arcana-meta">{% if c.data.group %}{{ c.data.group }} · {% endif %}{{ works.length }} work{{ "" if works.length == 1 else "s" }}</span>
        {% if cover %}<span class="arcana-thumb"><img src="{{ cover }}" alt="" draggable="false" sizes="120px"></span>{% endif %}
      </a>
    </li>
  {% endfor %}
</ol>
