{%- set networks = [
  ["instagram", "Instagram"], ["etsy_shop", "Etsy"], ["pinterest", "Pinterest"],
  ["tiktok", "TikTok"], ["facebook", "Facebook"], ["youtube", "YouTube"],
  ["threads", "Threads"], ["x", "X"]
] -%}
<ul class="social">
  {% for key, label in networks %}{% if site.social[key] %}
    <li><a href="{{ site.social[key] }}" target="_blank" rel="noopener noreferrer me">{{ label }}</a></li>
  {% endif %}{% endfor %}
  {% if site.email %}<li><a href="{{ ('mailto:' + site.email) | obfuscate | safe }}">Email</a></li>{% endif %}
</ul>
