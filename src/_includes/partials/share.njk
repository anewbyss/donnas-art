{#- Share buttons. Expects `shareUrl`, `shareTitle`, `shareImage`. -#}
{%- set u = shareUrl | urlencode -%}
{%- set t = shareTitle | urlencode -%}
<div class="share" data-share-url="{{ shareUrl }}" data-share-title="{{ shareTitle }}">
  <span class="share-label">Share</span>
  <button type="button" class="btn-chip js-native-share" hidden>Share…</button>
  <a class="btn-chip" target="_blank" rel="noopener" href="https://www.facebook.com/sharer/sharer.php?u={{ u }}">Facebook</a>
  <a class="btn-chip" target="_blank" rel="noopener" href="https://pinterest.com/pin/create/button/?url={{ u }}&media={{ shareImage | urlencode }}&description={{ t }}">Pinterest</a>
  <a class="btn-chip" target="_blank" rel="noopener" href="https://x.com/intent/post?url={{ u }}&text={{ t }}">X</a>
  <a class="btn-chip" target="_blank" rel="noopener" href="https://wa.me/?text={{ t }}%20{{ u }}">WhatsApp</a>
  <a class="btn-chip" href="mailto:?subject={{ t }}&body={{ u }}">Email</a>
  <button type="button" class="btn-chip js-copy-link">Copy link</button>
</div>
