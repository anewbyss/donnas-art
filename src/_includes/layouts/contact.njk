---
layout: layouts/base.njk
---
<section class="chapter correspondence">
  <div>
    <p class="mono kicker">{{ title }}</p>
    <h1>{{ heading or title }}</h1>
    <div class="prose">{{ content | safe }}</div>

    {% if site.commissions_open %}
      <div class="notice" id="commissions">
        <p class="mono kicker">Commissions are open</p>
        <p>{{ site.commissions_text }}</p>
      </div>
    {% endif %}

    <p class="mono kicker">Elsewhere</p>
    {% include "partials/social.njk" %}
  </div>

  <form class="letter" id="request"
        {% if site.contact_form_endpoint %}action="{{ site.contact_form_endpoint }}" method="POST"{% else %}data-mailto="{{ site.email | obfuscate }}"{% endif %}>
    <label><span class="mono">Your name</span><input name="name" required autocomplete="name" maxlength="100"></label>
    <label><span class="mono">Your email</span><input name="email" type="email" required autocomplete="email" maxlength="200"></label>
    <label><span class="mono">Regarding</span>
      <select name="topic">
        {% if site.commissions_open %}<option>Commission / art request</option>{% endif %}
        <option>Buying a piece</option>
        <option>Prints</option>
        <option>Something else</option>
      </select>
    </label>
    <label><span class="mono">Which work (optional)</span><input name="artwork" id="about-field" maxlength="200"></label>
    <label><span class="mono">Your message</span><textarea name="message" rows="7" required maxlength="5000" placeholder="Ideas, sizes, budget, timing — whatever helps."></textarea></label>
    {# Hidden trap field: real people never see it, spam robots fill it in. #}
    <div class="trap" aria-hidden="true"><label>Leave this empty<input type="text" name="_gotcha" tabindex="-1" autocomplete="off"></label></div>
    <button class="btn" type="submit">Send</button>
    {% if not site.contact_form_endpoint %}<p class="muted small">This opens your email app with the letter ready to send.</p>{% endif %}
  </form>
</section>
