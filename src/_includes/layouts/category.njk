---
layout: layouts/base.njk
---
{%- set works = collections.artworks | inCategory(title) -%}
<section class="chapter page-head">
  <p class="mono kicker"><a href="/collections/">Arcana</a>{% if group %} / {{ group }}{% endif %} · {{ works.length }} work{{ "" if works.length == 1 else "s" }}</p>
  <h1>{{ title }}</h1>
  {% if content | trim %}<div class="prose incant">{{ content | safe }}</div>{% endif %}
</section>
<section class="chapter">
  {% if works.length %}
    <div class="plates">
      {% for art in works %}{% include "partials/card.njk" %}{% endfor %}
    </div>
  {% else %}
    <p class="muted">Works for this chapter are still being gathered.</p>
  {% endif %}
  {% set shareUrl = page.url | absolute(env.siteUrl) %}{% set shareTitle = title + " — " + site.title %}{% set shareImage = ((image or site.hero_image) | imageUrl(1200)) | absolute(env.siteUrl) %}
  {% include "partials/share.njk" %}
</section>
