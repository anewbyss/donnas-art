---
layout: layouts/base.njk
---
<article class="chapter leaf{% if image %} leaf-with-image{% endif %}">
  {% if image %}
    <div class="arch arch-small"><img src="{{ image }}" alt="{{ title }}" draggable="false" sizes="(min-width: 900px) 400px, 80vw" loading="eager"></div>
  {% endif %}
  <div>
    <p class="mono kicker">{{ title }}</p>
    <h1>{{ heading or title }}</h1>
    <div class="prose">{{ content | safe }}</div>
  </div>
</article>
