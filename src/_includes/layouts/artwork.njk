---
layout: layouts/base.njk
---
{%- set images = image | withExtras(more_images) -%}
{%- set pageUrl = page.url | absolute(env.siteUrl) -%}
{%- set nb = collections.artworks | neighbours(page.url) -%}
{%- set cats = collections.categories | categoriesFor(categories) -%}
{%- set plate = collections.artworks | plateNo(page.url) -%}
<article class="specimen">
  <div class="specimen-media">
    {% for img in images %}
      <a class="mat" href="{{ img | imageUrl }}" data-lightbox="artwork" aria-label="View larger">
        <img src="{{ img }}" alt="{{ alt or title }}{% if not loop.first %} (view {{ loop.index }}){% endif %}" draggable="false"
             sizes="(min-width: 1100px) 680px, 92vw"{% if loop.first %} loading="eager" fetchpriority="high"{% endif %}>
      </a>
    {% endfor %}
  </div>

  <div class="specimen-label">
    <p class="mono crumb"><a href="/gallery/">The Works</a> / Plate {{ plate }}</p>
    <h1>{{ title }}</h1>
    <table class="ledger">
      {% if year %}<tr><th>Year</th><td>{{ year }}</td></tr>{% endif %}
      {% if medium %}<tr><th>Medium</th><td>{{ medium }}</td></tr>{% endif %}
      {% if size %}<tr><th>Size</th><td>{{ size }}</td></tr>{% endif %}
      {% if status %}<tr><th>Status</th><td><span class="status status-{{ status }}">{{ status | statusLabel }}</span></td></tr>{% endif %}
      {% if cats.length %}<tr><th>Arcana</th><td>{% for c in cats %}<a href="{{ c.url }}">{{ c.data.title }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</td></tr>{% endif %}
    </table>

    {% if content | trim %}<div class="prose">{{ content | safe }}</div>{% endif %}

    {% include "partials/buy.njk" %}

    {% set shareUrl = pageUrl %}{% set shareTitle = title + " — " + site.title %}{% set shareImage = (image | imageUrl(1200)) | absolute(env.siteUrl) %}
    {% include "partials/share.njk" %}
  </div>
</article>

<nav class="turn-page mono" aria-label="More works">
  {% if nb.next %}<a href="{{ nb.next.url }}"><span>← Earlier plate</span>{{ nb.next.data.title }}</a>{% else %}<span></span>{% endif %}
  {% if nb.prev %}<a href="{{ nb.prev.url }}" class="right"><span>Later plate →</span>{{ nb.prev.data.title }}</a>{% endif %}
</nav>

{% set rel = collections.artworks | related(page.url, 3) %}
{% if rel.length %}
<section class="chapter">
  <header class="chapter-head"><h2>Kindred works</h2></header>
  <div class="plates plates-3">
    {% for art in rel %}{% include "partials/card.njk" %}{% endfor %}
  </div>
</section>
{% endif %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "VisualArtwork",
  "name": {{ title | json | safe }},
  "image": {{ shareImage | json | safe }},
  "url": {{ pageUrl | json | safe }},
  "creator": { "@type": "Person", "name": {{ site.title | json | safe }} },
  "copyrightHolder": { "@type": "Person", "name": {{ site.title | json | safe }} }
  {%- if medium %}, "artMedium": {{ medium | json | safe }}{% endif %}
  {%- if year %}, "dateCreated": {{ year | string | json | safe }}{% endif %}
  {%- if status == "available" and price %},
  "offers": { "@type": "Offer", "price": {{ price | json | safe }}, "priceCurrency": {{ site.paypal.currency | json | safe }}, "availability": "https://schema.org/InStock" }
  {%- endif %}
}
</script>
