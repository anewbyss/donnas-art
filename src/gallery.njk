---
layout: layouts/base.njk
title: The Works
description: The complete catalogue of works — filter by style, era and theme.
permalink: /gallery/
---
<section class="chapter page-head">
  <p class="mono kicker">Catalogue · {{ collections.artworks.length }} plates</p>
  <h1>The Works</h1>
</section>

<section class="chapter">
  <div class="filters mono" role="group" aria-label="Filter works">
    <div class="filter-line">
      <span class="filter-label">Show</span>
      <button type="button" class="is-active" data-filter="all" aria-pressed="true">Everything</button>
      <label class="toggle"><input type="checkbox" id="available-only"> Only works for sale</label>
    </div>
    {% for group in collections.categories | groupCategories %}
      <div class="filter-line">
        <span class="filter-label">{{ group.name }}</span>
        {% for c in group.items %}
          <button type="button" data-filter="{{ c.data.title | slugify }}" aria-pressed="false">{{ c.data.title }}</button>
        {% endfor %}
      </div>
    {% endfor %}
  </div>

  <div class="plates" id="gallery-grid">
    {% for art in collections.artworks %}{% include "partials/card.njk" %}{% endfor %}
  </div>
  <p class="muted empty-note" hidden>Nothing here yet — try another filter.</p>
</section>
