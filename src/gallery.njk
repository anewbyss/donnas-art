---
layout: layouts/base.njk
title: Gallery
description: The complete gallery — every piece, filterable by style, era and theme.
permalink: /gallery/
---
<section class="wrap page-head">
  <h1>Gallery</h1>
  <p class="lead">{{ collections.artworks.length }} pieces and counting. Use the filters to explore by style, era or theme.</p>
</section>

<section class="wrap">
  <div class="filters" role="group" aria-label="Filter artwork">
    <div class="filter-row">
      <button type="button" class="btn-chip is-active" data-filter="all" aria-pressed="true">All</button>
      {% for group in collections.categories | groupCategories %}
        <span class="filter-group-label">{{ group.name }}</span>
        {% for c in group.items %}
          <button type="button" class="btn-chip" data-filter="{{ c.data.title | slugify }}" aria-pressed="false">{{ c.data.title }}</button>
        {% endfor %}
      {% endfor %}
    </div>
    <label class="toggle"><input type="checkbox" id="available-only"> Available to buy only</label>
  </div>

  <div class="grid masonry" id="gallery-grid">
    {% for art in collections.artworks %}{% include "partials/card.njk" %}{% endfor %}
  </div>
  <p class="muted empty-note" hidden>No pieces match those filters yet.</p>
</section>
